// PageError is an error of a walk of a list: Token is the token of the
// page it asked for, "" for the first.
type PageError struct {
	Token string
	Err   error
}

func (e *PageError) Error() string { return "reading a page of the list: " + e.Err.Error() }

func (e *PageError) Unwrap() error { return e.Err }

var (
	// ErrEmptyPageToken, ErrRepeatedPageToken and ErrPageTokenNotString
	// are a nextPageToken that is the server's fault: null or empty, one
	// the walk was at before, which would never end it, and one that is not
	// a string.
	ErrEmptyPageToken     = errors.New("the server sent an empty nextPageToken")
	ErrRepeatedPageToken  = errors.New("the server sent a nextPageToken it had sent before")
	ErrPageTokenNotString = errors.New("the server sent a nextPageToken that is not a string")
)

// walk is where a walk of a list is: the token of the page it asks for, ""
// for the first, and every token it was at.
type walk struct {
	token string
	seen  map[string]bool
}

func walkFrom(start *string) *walk {
	w := &walk{seen: map[string]bool{}}
	if start != nil {
		w.token = *start
		w.seen[*start] = true
	}
	return w
}

// next is the token of the page after the one whose body is page, as the
// document has it: an absent member ends the list; a present one is a
// string, not empty and new to the walk.
func (w *walk) next(page []byte) (*string, error) {
	var members map[string]json.RawMessage
	if err := json.Unmarshal(page, &members); err != nil {
		return nil, err
	}
	raw, ok := members["nextPageToken"]
	if !ok {
		return nil, nil
	}
	var token string
	switch {
	case string(bytes.TrimSpace(raw)) == "null":
		return nil, ErrEmptyPageToken
	case json.Unmarshal(raw, &token) != nil:
		return nil, ErrPageTokenNotString
	case token == "":
		return nil, ErrEmptyPageToken
	case w.seen[token]:
		return nil, ErrRepeatedPageToken
	}
	w.seen[token] = true
	w.token = token
	return &token, nil
}

// tokenKind is err, the error of a page, said as the walk says a token
// when the page is right but for its nextPageToken: null is
// ErrEmptyPageToken, and a token that is not a string ErrPageTokenNotString,
// which the shape and the decoder would say in their own words. The faults
// of a page are said in one order: its status (an undocumented one is the
// error, whatever the body), then its shape and its rows, then its token.
func tokenKind[Page any](err error) error {
	ae, ok := errors.AsType[*AnswerError](err)
	if !ok || ae.Response.StatusCode/100 != 2 || errors.Is(ae.Err, ErrStatus) {
		return err
	}
	// Only a token at fault is said anew; a page that does not read, or
	// any other fault, stays the error it came as.
	_, terr := (&walk{seen: map[string]bool{}}).next(ae.Body)
	if !errors.Is(terr, ErrEmptyPageToken) && !errors.Is(terr, ErrPageTokenNotString) {
		return err
	}
	// A fault of a row comes before one of the token, and the read of the
	// page said it already (pageFault).
	if rowsFault(ae.Body, new(Page)) != nil {
		return err
	}
	if errors.Is(terr, ErrPageTokenNotString) {
		return &AnswerError{Response: ae.Response, Body: ae.Body, Err: ErrPageTokenNotString}
	}
	return terr
}

// collect gathers the rows of a walk, and walks again from the first page
// once when the server refuses a token.
func collect[Row any](pages iter.Seq2[[]Row, error]) ([]Row, error) {
	for try := 0; ; try++ {
		var rows []Row
		var err error
		for got, e := range pages {
			if e != nil {
				err = e
				break
			}
			rows = append(rows, got...)
		}
		var re *ResponseError
		if try == 0 && errors.As(err, &re) && re.Problem != nil && re.Problem.Code == ProblemCodeInvalidPageToken {
			continue
		}
		if err != nil {
			return nil, err
		}
		return rows, nil
	}
}
