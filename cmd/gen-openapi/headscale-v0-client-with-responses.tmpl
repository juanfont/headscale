// ResponseError is an answer that is not a success: its status, and the
// problem when the body is one.
type ResponseError struct {
	Response *http.Response
	Body     []byte
	// Problem is the problem the body holds; nil for a body that is none,
	// such as the page of a proxy.
	Problem *Problem
}

func (e *ResponseError) Error() string {
	if e.Problem != nil {
		return fmt.Sprintf("%s: %s", e.Response.Status, e.Problem.Code)
	}
	return e.Response.Status
}

// AnswerError is an answer the client cannot read. Err says why:
// ErrStatus, ErrContentType, a *shape.Error, or what the decoder said.
type AnswerError struct {
	Response *http.Response
	Body     []byte
	// Want are the statuses of success the document names for the
	// operation, with ErrStatus.
	Want []int
	Err  error
}

func (e *AnswerError) Error() string {
	return fmt.Sprintf("reading the %s answer: %v", e.Response.Status, e.Err)
}

func (e *AnswerError) Unwrap() error { return e.Err }

var (
	// ErrStatus is a success with a status the document does not name for
	// the operation.
	ErrStatus = errors.New("a status of success the operation does not answer")
	// ErrContentType is a success whose Content-Type is none the document
	// gives the operation.
	ErrContentType = errors.New("the body is not of the content type the operation answers")
)

// problemIn is the problem body holds: one that reads by the exact member
// names and has a code; nil for any other body, such as the page of a
// proxy. Result, Err and the typed problem of a Parse function all read a
// refusal so.
func problemIn(body []byte) *Problem {
	var p Problem
	if DecodeResponse(body, &p) != nil || p.Code == "" {
		return nil
	}
	return &p
}

// told is r, the answer of a call made with ctx, having told the decoded
// function of ctx (WithDecoded) its success.
func told[R interface{ decodedSuccess() (any, []byte) }](ctx context.Context, r R, err error) (R, error) {
	if err != nil {
		return r, err
	}
	if f, ok := ctx.Value(decodedKey{}).(func(any, []byte)); ok && f != nil {
		if v, raw := r.decodedSuccess(); v != nil {
			f(v, raw)
		}
	}
	return r, nil
}

// answerOf is nil for an answer whose status is one of want; any other
// answer as an error.
func answerOf(rsp *http.Response, body []byte, want []int) error {
	switch {
	case rsp.StatusCode/100 != 2:
		return &ResponseError{Response: rsp, Body: body, Problem: problemIn(body)}
	case !slices.Contains(want, rsp.StatusCode):
		return &AnswerError{Response: rsp, Body: body, Want: want, Err: ErrStatus}
	}
	return nil
}

