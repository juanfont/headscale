// {{$opid}}Pages walks {{$opid}} from the page params names (the first,
// when params has no PageToken) to the last, the page whose nextPageToken
// is absent: every page as the client read it, Body included. A page is
// yielded only once it is read whole, its token too: a nextPageToken that
// is null, empty, not a string, or one the walk was at before is the
// server's fault, and ends the walk with that error. Any error ends it as
// a *PageError naming the token of the page it asked for. It never starts
// over: the rows of the pages before were yielded.
func (c *ClientWithResponses) {{$opid}}Pages(ctx context.Context, params *{{$opid}}Params, reqEditors ...RequestEditorFn) iter.Seq2[*{{genResponseTypeName $opid}}, error] {
	return func(yield func(*{{genResponseTypeName $opid}}, error) bool) {
		var p {{$opid}}Params
		if params != nil {
			p = *params
		}
		w := walkFrom(p.PageToken)
		for {
			resp, err := c.{{$opid}}WithResponse(ctx, &p, reqEditors...)
			if err == nil {
				_, err = resp.Result()
			}
			var next *string
			if err == nil {
				next, err = w.next(resp.Body)
			}
			if err != nil {
				yield(nil, &PageError{Token: w.token, Err: tokenKind[{{$page}}](err)})
				return
			}
			if !yield(resp, nil) || next == nil {
				return
			}
			p.PageToken = next
		}
	}
}

// {{$opid}}All is every {{$row}} of {{$opid}}, from the first page, whatever
// PageToken params holds. A token the server refuses (invalid_page_token,
// as after a restart) starts the walk over, once.
func (c *ClientWithResponses) {{$opid}}All(ctx context.Context, params *{{$opid}}Params, reqEditors ...RequestEditorFn) ([]{{$row}}, error) {
	var p {{$opid}}Params
	if params != nil {
		p = *params
	}
	p.PageToken = nil
	return collect(func(yield func([]{{$row}}, error) bool) {
		for resp, err := range c.{{$opid}}Pages(ctx, &p, reqEditors...) {
			var rows []{{$row}}
			if err == nil {
				rows = resp.JSON200.{{$field}}
			}
			if !yield(rows, err) {
				return
			}
		}
	})
}
