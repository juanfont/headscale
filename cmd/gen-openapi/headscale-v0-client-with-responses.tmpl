// Got is the result of a call whose answer has Result, as a value:
// Got(c.GetNodeWithResponse(ctx, id)).
func Got[R interface{ Result() (*T, error) }, T any](r R, err error) (T, error) {
	var zero T
	if err != nil {
		return zero, err
	}
	v, err := r.Result()
	if err != nil {
		return zero, err
	}
	return *v, nil
}

// Done is the error of a call whose answer has Err: Done(c.DeleteNodeWithResponse(ctx, id, nil)).
func Done[R interface{ Err() error }](r R, err error) error {
	if err != nil {
		return err
	}
	return r.Err()
}

