FROM docker.io/golang:1.26.5-trixie AS builder
WORKDIR /go/src/headscale
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /go/bin/headscale ./cmd/headscale

FROM debian:trixie-slim

RUN apt-get --update install --no-install-recommends --yes \
    bash ca-certificates curl dnsutils findutils iproute2 jq less procps \
    python3 sqlite3 wget unzip iptables \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Install tailscale
RUN curl -fsSL https://tailscale.com/install.sh | sh

# Copy headscale CLI from builder
COPY --from=builder /go/bin/headscale /usr/local/bin/headscale

# Copy test scripts
COPY e2e/tests/ /tests/
RUN chmod +x /tests/*.sh

WORKDIR /tests

ENTRYPOINT ["bash", "/tests/run_all.sh"]
