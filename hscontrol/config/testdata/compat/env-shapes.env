HEADSCALE_SERVER_URL=https://hs.example.com
HEADSCALE_NOISE_PRIVATE_KEY_PATH=/var/lib/headscale/noise.key
HEADSCALE_PREFIXES_V4=100.64.0.0/10
HEADSCALE_DATABASE_TYPE=sqlite
HEADSCALE_DATABASE_SQLITE_PATH=/var/lib/headscale/db.sqlite
HEADSCALE_DNS_MAGIC_DNS=false
HEADSCALE_DNS_OVERRIDE_LOCAL_DNS=false
# Lists: JSON arrays, commas and padding are not parsed.
HEADSCALE_DNS_SEARCH_DOMAINS=["a.example.com","b.example.com"]
HEADSCALE_DNS_NAMESERVERS_GLOBAL=1.1.1.1,8.8.8.8
HEADSCALE_OIDC_ALLOWED_DOMAINS=["example.com"]
HEADSCALE_OIDC_ALLOWED_GROUPS=  a  b
HEADSCALE_DERP_URLS=https://a.example.com/derp.json https://b.example.com/derp.json
HEADSCALE_TRUSTED_PROXIES=10.0.0.0/8 192.168.0.0/16
# Maps: non-JSON value, non-string value, key case.
HEADSCALE_DNS_NAMESERVERS_SPLIT=corp.example.com=10.0.0.1
HEADSCALE_OIDC_EXTRA_PARAMS={"Domain_Hint":"env","n":1}
# Scalars: durations without unit, octal mode, numeric bool.
HEADSCALE_TUNING_BATCH_CHANGE_DELAY=800
HEADSCALE_DERP_UPDATE_FREQUENCY=30
HEADSCALE_NODE_EXPIRY=90
HEADSCALE_UNIX_SOCKET_PERMISSION=0700
HEADSCALE_TAILDROP_ENABLED=0
