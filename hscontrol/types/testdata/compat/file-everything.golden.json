        {
          "Name": "grafana.tailnet.example.net",
          "Type": "A",
          "Value": "100.64.0.3"
        }
      ]
    },
    "DNSChallenge": {
      "PropagationTimeout": 180000000000,
      "Resolvers": [
        "9.9.9.9:53"
      ],
      "ProviderName": ""
    },
    "UnixSocket": "/run/headscale/headscale.sock",
    "UnixSocketPermission": 448,
    "OIDC": {
      "OnlyStartIfOIDCIsAvailable": false,
      "Issuer": "https://idp.example.com",
      "ClientID": "headscale",
      "Scope": [
        "openid",
        "profile",
        "email",
        "groups"
      ],
      "ExtraParams": {
        "login_hint": "file"
      },
      "AllowedDomains": [
        "example.com"
      ],
      "AllowedUsers": [
        "alice@example.com"
      ],
      "AllowedGroups": [
        "/headscale"
      ],
      "EmailVerifiedRequired": false,
      "UseExpiryFromToken": true,
      "PKCE": {
        "Enabled": true,
        "Method": "plain"
      }
    },
    "LogTail": {
      "Enabled": true
    },
    "Taildrop": {
      "Enabled": false
    },
    "AutoUpdate": {
      "Enabled": true
    },
    "CLI": {
      "Address": "headscale.example.com:443",
      "Timeout": 15000000000,
      "Insecure": true
    },
    "Policy": {
      "Path": "",
      "Mode": "database"
    },
    "Tuning": {
      "NotifierSendTimeout": 1000000000,
      "BatchChangeDelay": 500000000,
      "NodeMapSessionBufferedChanSize": 50,
      "BatcherWorkers": 4096,
      "RegisterCacheExpiration": 1200000000000,
      "RegisterCacheMaxEntries": 2000,
      "NodeStoreBatchSize": 50,
      "NodeStoreBatchTimeout": 250000000
    }
  },
  "secrets": {
    "cli.api_key": "marker-cli-api-key",
    "database.postgres.pass": "marker-postgres-pass",
    "oidc.client_secret": "marker-oidc-secret-from-file"
