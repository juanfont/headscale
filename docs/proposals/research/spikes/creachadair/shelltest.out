== bash
headscale no<TAB>                          -> [nodes]
headscale nodes list --columns <TAB>       -> [id|name|owner|ip|version|online|last-seen|expiry|hostname]
headscale nodes list -o <TAB>              -> [json]
headscale policy set <TAB>                 -> []
headscale nodes list --columns id,na<TAB>  -> [id,name]
headscale nodes routes ap<TAB>             -> [approve]
headscale -c /x nodes l<TAB>               -> [list|ls]
== fish
headscale no<TAB>                          -> [nodes|]
headscale nodes list --columns <TAB>       -> [expiry|hostname|id|ip|last-seen|name|online|owner|version|]
headscale nodes list -o <TAB>              -> [json|]
headscale policy set <TAB>                 -> [(file names from cwd)]
headscale nodes list --columns id,na<TAB>  -> [id,name|]
headscale nodes routes ap<TAB>             -> [approve|]
headscale -c /x nodes l<TAB>               -> [list|ls|]
== zsh (script function _headscale called with _describe/_arguments stubbed: no line editor)
headscale no<TAB>                          -> [nodes]
headscale nodes list --columns <TAB>       -> [id name owner ip version online last-seen expiry hostname]
headscale nodes list -o <TAB>              -> [json]
headscale policy set <TAB>                 -> [FILES(*:filename:_files )]
headscale nodes list --columns id,na<TAB>  -> [id,name]
headscale nodes routes ap<TAB>             -> [approve]
headscale -c /x nodes l<TAB>               -> [list ls]
